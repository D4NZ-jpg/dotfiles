#!/usr/bin/env bash
# Kitty scratchpad shell: always attach to its own persistent tmux workspace.
set -euo pipefail

session=scratch
persist="$HOME/.config/tmux/bin/tmux-persist"

# If the scratchpad is the first terminal after login, restore all saved
# workspaces before creating its dedicated session.
if ! tmux has-session 2>/dev/null; then
    "$persist" restore >/dev/null 2>&1 || true
fi

if ! tmux has-session -t "=$session" 2>/dev/null; then
    tmux new-session -d -s "$session" -c "$HOME" -n scratch
    tmux set-window-option -t "$session:1" @note "scratchpad terminal"
fi

exec tmux attach-session -t "=$session"
