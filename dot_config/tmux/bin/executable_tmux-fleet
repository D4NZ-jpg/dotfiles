#!/usr/bin/env bash
# Overview of every pi session across all workspaces.
#
#   tmux-fleet          fzf list: state, age, workspace:window, title; Enter jumps
#   tmux-fleet --list   plain list (for the status line or scripts)
#   tmux-fleet --status one-line summary for the status bar
#
# State comes from the pi extension (@pi-state/@pi-since); windows with
# agent tracking but no pi state fall back to tmux's silence flag.
set -u
. "$(dirname "$(realpath "$0")")/fzf-modal.sh"

rows() {
    local now; now=$(date +%s)
    # bash `read` collapses consecutive tabs, so fields are pulled with cut.
    tmux list-windows -a -F '#{session_name}	#{window_index}	#{window_name}	#{@pi-state}	#{@pi-since}	#{?@note,#{@note},#{@auto-note}}	#{@agent}	#{window_silence_flag}#{window_bell_flag}	#{@pi-last}' \
    | while IFS= read -r line; do
        sess=$(cut -f1 <<<"$line"); idx=$(cut -f2 <<<"$line"); wname=$(cut -f3 <<<"$line")
        state=$(cut -f4 <<<"$line"); since=$(cut -f5 <<<"$line"); note=$(cut -f6 <<<"$line")
        agent=$(cut -f7 <<<"$line"); flags=$(cut -f8 <<<"$line"); last=$(cut -f9 <<<"$line")
        [ -z "$agent" ] && [ -z "$state" ] && continue
        if [ -z "$state" ]; then
            case "$flags" in *1*) state=done ;; *) state=working ;; esac
        fi
        age=""
        if [ -n "$since" ]; then
            s=$(( now - since ))
            if [ $s -lt 60 ]; then age="${s}s"; elif [ $s -lt 3600 ]; then age="$((s/60))m"; else age="$((s/3600))h$(( (s%3600)/60 ))m"; fi
        fi
        case "$state" in
            asking)  rank=0; icon='?' ;;
            error)   rank=1; icon='!' ;;
            done)    rank=2; icon='●' ;;
            working) rank=3; icon='…' ;;
            *)       rank=4; icon='·' ;;
        esac
        printf '%s\t%s:%s\t%s %-7s %5s  %-24s %-28.28s %s\n' "$rank" "$sess" "$idx" "$icon" "$state" "$age" "$sess:$wname" "$note" "${last:+$(printf '\e[2m')$last$(printf '\e[0m')}"
    done | sort -t$'\t' -k1,1n -k2,2 | cut -f2-
}

case "${1:-}" in
    --list) rows; exit 0 ;;
    --status)
        n_ask=0; n_done=0; n_work=0; n_err=0
        while IFS=$'\t' read -r _ line; do
            case "$line" in '? '*) n_ask=$((n_ask+1)) ;; '! '*) n_err=$((n_err+1)) ;; '● '*) n_done=$((n_done+1)) ;; '… '*) n_work=$((n_work+1)) ;; esac
        done < <(rows)
        out=""
        [ $n_ask -gt 0 ]  && out+="#[fg=#d9b090]?$n_ask "
        [ $n_err -gt 0 ]  && out+="#[fg=#d9b090]!$n_err "
        [ $n_done -gt 0 ] && out+="#[fg=#afa286]●$n_done "
        [ $n_work -gt 0 ] && out+="#[fg=#827c70]…$n_work "
        printf '%s' "$out"
        exit 0 ;;
esac

sel=$(rows | fzf --ansi --delimiter='\t' --with-nth=2 --no-sort --reverse --prompt='pi > ' "${FZF_MODAL[@]}" \
    --header=$'? asking      ! error       ● done        … working     · idle\nEnter jump    j/k move      / search      q quit' \
    --bind "$(fzf_modal_normal 'pi > ')" --bind "$(fzf_modal_search 'pi > ')" \
    --preview 'tmux capture-pane -p -t {1} | grep -v "^\s*$" | tail -30' \
    --preview-window=down,55%,border-top)
[ -n "$sel" ] && tmux switch-client -t "${sel%%	*}"
