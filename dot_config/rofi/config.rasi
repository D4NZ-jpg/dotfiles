configuration{
    modi: "drun,window,emoji";
    icon-theme: "Oranchelo";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{name}";
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    display-Network: "Network";
    display-emoji: "Emoji";
    display-calc: "Calculate";
    sidebar-mode: false;

}

@theme "~/.config/rofi/charcoal.rasi"
