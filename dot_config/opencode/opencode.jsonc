{
    "$schema": "https://opencode.ai/config.json",

    // Models
    "provider": {
        "amazon-bedrock": {
            "options": {
                "region": "us-east-1",
                "profile": "default"
            }
        }
    },
    "model": "amazon-bedrock/anthropic.claude-opus-4.5-20251101-v1:0",

    // Instructions
  "instructions": [
    "~/.config/opencode/instructions/*.md"
  ],

    // Plugin
    "plugin": [
        "@tarquinen/opencode-smart-title",
        "@zenobius/opencode-background"
     ],

    // MCP Servers
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "API_KEY"
            }
        }
    },

    // TUI Options
    "theme": "gruvbox"
}
