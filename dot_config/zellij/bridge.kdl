// Transport-only configuration. The remote server supplies tabs and pane UI.
default_shell "/usr/bin/zsh"
default_layout "default"
default_mode "locked"
mouse_mode true
pane_frames true
pane_frame_style "titles"
auto_layout false
session_serialization true
pane_viewport_serialization false
support_kitty_graphics_protocol true
show_release_notes false
show_startup_tips false
theme "charcoal"
ui {
    pane_frames {
        hide_session_name true
    }
}
themes {
    charcoal {
        fg 213 200 172
        bg 28 28 28
        black 28 28 28
        white 213 200 172
        red 193 116 104
        green 161 174 140
        yellow 213 200 172
        blue 150 163 171
        magenta 173 151 166
        orange 193 157 122
        cyan 149 173 169
    }
}
keybinds clear-defaults=true {
    normal {
        bind "Ctrl Space" { SwitchToMode "Tmux"; }
        bind "Ctrl w" { SwitchToMode "Pane"; }
        bind "Alt h" { MoveFocus "Left"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt l" { MoveFocus "Right"; }
    }
    locked {
        bind "Ctrl Space" { SwitchToMode "Tmux"; }
        // Vim receives Ctrl+W and Alt+hjkl unchanged.
    }
    shared_among "normal" "locked" {
        bind "Alt `" { Run "zellij-ws" "last" { floating true; close_on_exit true; }; }
    }
    pane {
        bind "Esc" { SwitchToMode "Locked"; }
        bind "h" "Left" { MoveFocus "Left"; SwitchToMode "Locked"; }
        bind "j" "Down" { MoveFocus "Down"; SwitchToMode "Locked"; }
        bind "k" "Up" { MoveFocus "Up"; SwitchToMode "Locked"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Locked"; }
        bind "s" { Run "zellij-ws" "action" "split-down" { floating true; x "0"; y "0"; width "1"; height "1"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "v" { Run "zellij-ws" "action" "split-right" { floating true; x "0"; y "0"; width "1"; height "1"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "q" { CloseFocus; SwitchToMode "Locked"; }
        bind "w" { SwitchFocus; SwitchToMode "Locked"; }
        bind "p" { FocusLastPane; SwitchToMode "Locked"; }
        bind "z" { Run "zellij-ws" "action" "fullscreen" { floating true; x "0"; y "0"; width "1"; height "1"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "H" { MovePane "Left"; SwitchToMode "Locked"; }
        bind "J" { MovePane "Down"; SwitchToMode "Locked"; }
        bind "K" { MovePane "Up"; SwitchToMode "Locked"; }
        bind "L" { MovePane "Right"; SwitchToMode "Locked"; }
        bind "Ctrl w" { Write 23; SwitchToMode "Locked"; }
    }
    scroll {
        bind "Esc" "q" "Ctrl c" { ScrollToBottom; SwitchToMode "Locked"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
    }
    tmux {
        bind "Esc" "Ctrl Space" { SwitchToMode "Locked"; }
        bind "h" { Run "zellij-ws" "action" "previous-tab" { floating true; x "0"; y "0"; width "1"; height "1"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "l" { Run "zellij-ws" "action" "next-tab" { floating true; x "0"; y "0"; width "1"; height "1"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "s" { Run "zellij-ws" "pick" "workspaces" { floating true; x "15%"; y "20%"; width "70%"; height "60%"; name "Workspaces"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "o" { Run "zellij-ws" "project" { floating true; x "15%"; y "20%"; width "70%"; height "60%"; name "Projects"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "w" { Run "zellij-ws" "pick" "tree" { floating true; x "15%"; y "20%"; width "70%"; height "60%"; name "Tasks"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "g" { Run "zellij-ws" "pick" "attention" { floating true; x "15%"; y "20%"; width "70%"; height "60%"; name "Attention"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "G" { Run "zellij-ws" "pick" "fleet" { floating true; x "15%"; y "20%"; width "70%"; height "60%"; name "Agents"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "n" { Run "zellij-ws" "note-prompt" { floating true; x "20%"; y "35%"; width "60%"; height "30%"; name "Task name"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "c" { Run "zellij-ws" "new-tab" { floating true; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "C" { Run "zellij-ws" "project" "--new-tab" { floating true; x "15%"; y "20%"; width "70%"; height "60%"; name "New task"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "," { Run "zellij-ws" "rename-tab" { floating true; x "20%"; y "35%"; width "60%"; height "30%"; name "Task name"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "M" { Run "zellij-ws" "move" { floating true; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "r" { Run "zellij-ws" "save" { floating true; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "-" "\"" { Run "zellij-ws" "action" "split-down" { floating true; x "0"; y "0"; width "1"; height "1"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "|" "%" { Run "zellij-ws" "action" "split-right" { floating true; x "0"; y "0"; width "1"; height "1"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "z" { Run "zellij-ws" "action" "fullscreen" { floating true; x "0"; y "0"; width "1"; height "1"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "[" { Run "zellij-ws" "action" "start-scroll" { floating true; x "0"; y "0"; width "1"; height "1"; close_on_exit true; }; SwitchToMode "Locked"; }
        bind "d" { Detach; }
    }
}
