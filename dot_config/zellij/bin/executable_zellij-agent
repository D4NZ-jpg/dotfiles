#!/usr/bin/env python3
"""Resume only the recorded private Pi session, or leave a usable shell."""
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

def has_pi_process(root_pid):
    pending, seen = [str(root_pid)], set()
    while pending:
        pid = pending.pop()
        if pid in seen: continue
        seen.add(pid)
        try:
            proc = Path('/proc') / pid
            command = (proc / 'comm').read_text().strip()
            if command in ('pi', 'pi-coding-agent'): return True
            if command in ('node', 'nodejs'):
                argv = (proc / 'cmdline').read_bytes().split(b'\0')
                if any(Path(os.fsdecode(arg)).name == 'pi' or
                       (b'coding-agent' in arg and arg.endswith(b'cli.js')) for arg in argv):
                    return True
            pending.extend((proc / 'task' / pid / 'children').read_text().split())
        except OSError:
            continue
    return False


root = Path(os.environ.get('ZELLIJ_WS_STATE', str(Path.home() / '.local/state/zellij-workspaces')))
token = sys.argv[1] if len(sys.argv) == 2 else ''
if not re.fullmatch(r'[0-9a-f]{32}', token):
    sys.exit('Invalid Pi restoration token')
record = root / 'agents' / (token + '.json')
try:
    data = json.loads(record.read_text())
    session = data['session_file']
    if not Path(session).is_file():
        raise ValueError('The saved Pi session file is missing; refusing to start a different thread')
    if shutil.which('tmux'):
        result = subprocess.run(['tmux', 'list-panes', '-a', '-F', '#{@pi-session}\t#{pane_pid}'],
                                capture_output=True, text=True, timeout=5)
        active = [line.split('\t', 1) for line in result.stdout.splitlines()]
        if any(len(parts) == 2 and parts[0] == session and has_pi_process(parts[1]) for parts in active):
            raise ValueError('This Pi thread is still open in tmux. Finish/exit that Pi before resuming it here')
    # Prevent a second restored pane from opening an already active thread.
    for path in (root / 'panes').glob('*.json'):
        for row in json.loads(path.read_text()).values():
            if row.get('owner') and row.get('session_file') == session:
                try:
                    stat = Path(f'/proc/{int(row["pid"])}/stat').read_text().rsplit(')', 1)[1].split()[19]
                except (OSError, ValueError, KeyError, IndexError):
                    continue
                if stat == row.get('stamp'):
                    raise ValueError('This Pi thread is already running in Zellij')
    env = dict(os.environ, ZELLIJ_RESTORE_TOKEN=token)
    subprocess.run(['pi', '--session', session], env=env, check=False)
except (OSError, ValueError, KeyError, json.JSONDecodeError, subprocess.SubprocessError) as error:
    print(f'Pi restore: {error}', file=sys.stderr)
    print('Your saved conversation was not changed.', file=sys.stderr)
# Leave a usable shell after Pi exits or a restoration is blocked.
os.environ.pop('ZELLIJ_RESTORE_TOKEN', None)
os.execvp(os.environ.get('SHELL', '/usr/bin/zsh'), [os.environ.get('SHELL', '/usr/bin/zsh'), '-l'])
